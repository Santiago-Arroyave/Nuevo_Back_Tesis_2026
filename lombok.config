config.stopBubbling = true
lombok.anyConstructor.addConstructorProperties = true
lombok.copyConstructor.suppressConstructorProperties = true
lombok.equalsAndHashCode.suppressConstructorProperties = true
lombok.toString.suppressConstructorProperties = true
lombok.builder.suppressConstructorProperties = true
lombok.ArgsConstructor.suppressConstructorProperties = true
lombok.NoArgsConstructor.suppressConstructorProperties = true
lombok.AllArgsConstructor.suppressConstructorProperties = true
lombok.Data.suppressConstructorProperties = true
lombok.Value.suppressConstructorProperties = true